# Copy to .env for local preview (node server.mjs). On Vercel, add these under
# Settings > Environment Variables. Never commit .env.

# Required for the assistant
ANTHROPIC_API_KEY=
CHAT_SECRET=                # any long random string; signs verification and session tokens
CHAT_MODEL=claude-opus-5    # optional
CHAT_EFFORT=medium          # optional: low | medium | high

# Tenant directory (one of these). Columns: reference,name,email,phone,address,notes
TENANT_DIRECTORY_URL=       # e.g. a Google Sheet published to the web as CSV
TENANT_DIRECTORY_JSON=      # or inline JSON array

# Zoho CRM (preferred source for tenants, landlords, properties, repairs and documents)
# Self Client from https://api-console.zoho.com, then node scripts/zoho-token.mjs
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_DC=com
# Landlord portal: addresses that may sign in and see every property (comma-separated)
PORTAL_ADMIN_EMAILS=
PORTAL_ADMIN_NAME=

# Fallback only when Zoho is not configured: three sheets published as CSV (see docs/landlord-*.csv)
LANDLORD_DIRECTORY_URL=
PROPERTY_DIRECTORY_URL=
DOCUMENT_DIRECTORY_URL=

# Email (one-time codes, job notifications, confirmations) via resend.com
RESEND_API_KEY=
MAIL_FROM=Property Sauce <assistant@propertysauce.co>
TEAM_EMAIL=contact@propertysauce.co

# SMS codes via Inkbox, on our own UK number (+44 7457 410735). Tried before
# Twilio when both are set. INKBOX_PHONE_NUMBER_ID is not a secret. Create
# the API key at https://inkbox.ai/console/api-keys, agent-scoped to
# @propertysauce; the webhook secret is returned once when the inbound
# webhook subscription is created (see docs/DEPLOY.md).
INKBOX_API_KEY=
INKBOX_PHONE_NUMBER_ID=52c81de9-a09a-4997-bd7f-56ae78380cee
INKBOX_WEBHOOK_SECRET=

# Optional fallback: SMS codes via Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Optional: every raised job is also POSTed here (Zapier, Make, Trello, etc.)
MAINTENANCE_WEBHOOK_URL=

# Local testing only: return the one-time code in the API response
CHAT_DEV_ECHO_CODE=0
